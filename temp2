private static extractProjectIdFromBodyString(body: string): OptionalProjectId {
  const projectIdMatch = body.match(/\bproject_id\s*:\s*['"]?(\d+)['"]?/i);

  return projectIdMatch?.[1];
}

private static extractProjectIdFromBody(body: unknown): OptionalProjectId {
  if (!body) {
    return undefined;
  }

  if (typeof body === 'string') {
    return CuNodeWebhookController.extractProjectIdFromBodyString(body);
  }

  if (typeof body === 'object') {
    const bodyRecord = body as Record<string, unknown>;
    const projectId = bodyRecord.projectId ?? bodyRecord.project_id;

    if (typeof projectId === 'string' || typeof projectId === 'number') {
      return projectId;
    }
  }

  return undefined;
}

private static extractProjectId(payload: CuNodeWebhookPayload): OptionalProjectId {
  return (
    CuNodeWebhookController.extractProjectIdFromBody(payload.body) ??
    CuNodeWebhookController.extractProjectIdFromBody(payload.Body)
  );
}

