private static readonly DAM_RELATIONSHIP_RETRY_ATTEMPTS = 3;

private static readonly DAM_RELATIONSHIP_RETRY_DELAY_MS = 5000;

private static readonly RETRYABLE_DAM_STATUS_CODES = new Set([
  408,
  409,
  429,
  500,
  502,
  503,
  504,
]);

private static readonly RETRYABLE_DAM_ERROR_CODES = new Set([
  'ECONNRESET',
  'ETIMEDOUT',
]);

private static delay(milliseconds: number): Promise<void> {
  return new Promise((resolve) => {
    setTimeout(resolve, milliseconds);
  });
}

private static normalizeError(error: unknown): Error {
  if (error instanceof Error) {
    return error;
  }

  return new Error('Unknown DAM operation error');
}

private static isRetryableDamError(error: unknown): boolean {
  if (!axios.isAxiosError(error)) {
    return false;
  }

  const status = error.response?.status;
  const errorCode = error.code;

  const hasRetryableStatus =
    typeof status === 'number' &&
    DamClassificationService.RETRYABLE_DAM_STATUS_CODES.has(status);

  const hasRetryableErrorCode =
    typeof errorCode === 'string' &&
    DamClassificationService.RETRYABLE_DAM_ERROR_CODES.has(errorCode);

  return hasRetryableStatus || hasRetryableErrorCode;
}

private static shouldRetryDamOperation(
  error: unknown,
  attempt: number
): boolean {
  return (
    attempt < DamClassificationService.DAM_RELATIONSHIP_RETRY_ATTEMPTS &&
    DamClassificationService.isRetryableDamError(error)
  );
}

private static async executeDamOperationWithRetry<T>(
  operationName: string,
  operation: () => Promise<T>,
  logOptions: Record<string, unknown>,
  attempt = 1
): Promise<T> {
  try {
    return await operation();
  } catch (error) {
    const normalizedError = DamClassificationService.normalizeError(error);
    const shouldRetry = DamClassificationService.shouldRetryDamOperation(
      error,
      attempt
    );

    logger.warn({
      msg: shouldRetry
        ? 'Retrying DAM operation after failure'
        : 'DAM operation failed without retry',
      options: {
        ...logOptions,
        operationName,
        attempt,
        maxAttempts: DamClassificationService.DAM_RELATIONSHIP_RETRY_ATTEMPTS,
        retryDelayMs: shouldRetry
          ? DamClassificationService.DAM_RELATIONSHIP_RETRY_DELAY_MS
          : undefined,
        ...DamClassificationService.getErrorLogOptions(error),
      },
    });

    if (!shouldRetry) {
      throw normalizedError;
    }

    await DamClassificationService.delay(
      DamClassificationService.DAM_RELATIONSHIP_RETRY_DELAY_MS
    );

    return DamClassificationService.executeDamOperationWithRetry(
      operationName,
      operation,
      logOptions,
      attempt + 1
    );
  }
}


const response = await DamClassificationService.executeDamOperationWithRetry(
  'UPDATE_DAM_RELATIONSHIP_FIELD',
  () =>
    httpClient.put(
      `/api/core/classification/${validatedFollowerClassificationId}`,
      {
        fields: {
          addOrUpdate: [
            {
              id: validatedRelationshipFieldId,
              localizedValues: [
                {
                  languageId,
                  values: [validatedLeaderClassificationId],
                },
              ],
            },
          ],
        },
      },
      {
        headers: DamClassificationService.getJsonHeaders(),
      }
    ),
  {
    environment,
    followerClassificationId: validatedFollowerClassificationId,
    leaderClassificationId: validatedLeaderClassificationId,
    relationshipFieldId: validatedRelationshipFieldId,
  }
);


