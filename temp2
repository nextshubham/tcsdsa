type RetryOptions = {
  retries?: number;
  delayIncrementMs?: number;
  shouldRetry?: (error: unknown) => boolean;
  onRetry?: (error: unknown, retryAttempt: number, delayMs: number) => void;
};

export const getRetryDelay = (
  retryAttempt: number,
  delayIncrementMs = HTTP_RETRY_DELAY_INCREMENT_MS
): number => retryAttempt * delayIncrementMs;

const delayIncrementMs =
  options.delayIncrementMs ?? HTTP_RETRY_DELAY_INCREMENT_MS;

const delayMs = getRetryDelay(nextRetryAttempt, delayIncrementMs);




import { executeWithRetry, isRetryableHttpError } from '../utils/httpRetry';


const response = await executeWithRetry(
  () =>
    httpClient.put(
      `/api/core/classification/${validatedFollowerClassificationId}`,
      {
        fields: {
          addOrUpdate: [
            {
              id: validatedRelationshipFieldId,
              localizedValues: [
                {
                  languageId,
                  values: [validatedLeaderClassificationId],
                },
              ],
            },
          ],
        },
      },
      {
        headers: DamClassificationService.getJsonHeaders(),
      }
    ),
  {
    retries: 3,
    delayIncrementMs: 5000,
    shouldRetry: isRetryableHttpError,
    onRetry: (error, retryAttempt, delayMs) => {
      logger.warn({
        msg: 'Retrying DAM relationship field update',
        options: {
          environment,
          retryAttempt,
          delayMs,
          followerClassificationId: validatedFollowerClassificationId,
          leaderClassificationId: validatedLeaderClassificationId,
          relationshipFieldId: validatedRelationshipFieldId,
          ...DamClassificationService.getErrorLogOptions(error),
        },
      });
    },
  }
);


