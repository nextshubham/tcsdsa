private static isRetryableDamClassificationLinkingError(error: unknown): boolean {
  if (isRetryableHttpError(error)) {
    return true;
  }

  if (!axios.isAxiosError(error)) {
    return false;
  }

  return error.response?.status === 400;
}


Normally 400 should not be retried.
But for relationship/follower APIs, Aprimo can return 400 when newly created classification is not available internally yet.
So we retry 400 only for these two linking APIs, not globally.

const response = await executeWithRetry(
  () =>
    httpClient.put(
      `/api/core/classification/${validatedFollowerClassificationId}`,
      {
        fields: {
          addOrUpdate: [
            {
              id: validatedRelationshipFieldId,
              localizedValues: [
                {
                  languageId,
                  values: [validatedLeaderClassificationId],
                },
              ],
            },
          ],
        },
      },
      {
        headers: DamClassificationService.getJsonHeaders(),
      }
    ),
  {
    retries: 3,
    delayIncrementMs: 5000,
    shouldRetry: DamClassificationService.isRetryableDamClassificationLinkingError,
    onRetry: (error, retryAttempt, delayMs) => {
      logger.warn({
        msg: 'Retrying DAM relationship field update',
        options: {
          environment,
          retryAttempt,
          delayMs,
          followerClassificationId: validatedFollowerClassificationId,
          leaderClassificationId: validatedLeaderClassificationId,
          relationshipFieldId: validatedRelationshipFieldId,
          ...DamClassificationService.getErrorLogOptions(error),
        },
      });
    },
  }
);



