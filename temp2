private static readonly PROJECT_ID_BODY_PATTERN =
  /\bproject_id\s*:\s*['"]?(\d+)['"]?/i;

private static extractProjectIdFromBodyString(body: string): OptionalProjectId {
  const projectIdMatch =
    CuNodeWebhookController.PROJECT_ID_BODY_PATTERN.exec(body);

  return projectIdMatch?.[1];
}

