const response = await DamClassificationService.executeWithRetry(
  'UPDATE_DAM_RELATIONSHIP_FIELD',
  () =>
    httpClient.put(
      `/api/core/classification/${validatedFollowerClassificationId}`,
      {
        fields: {
          addOrUpdate: [
            {
              id: validatedRelationshipFieldId,
              localizedValues: [
                {
                  languageId,
                  values: [validatedLeaderClassificationId],
                },
              ],
            },
          ],
        },
      },
      {
        headers: DamClassificationService.getJsonHeaders(),
      }
    ),
  {
    environment,
    followerClassificationId: validatedFollowerClassificationId,
    leaderClassificationId: validatedLeaderClassificationId,
    relationshipFieldId: validatedRelationshipFieldId,
  }
);


const response = await DamClassificationService.executeWithRetry(
  'ADD_DAM_FOLLOWER_CLASSIFICATION',
  () =>
    httpClient.put(
      `/api/core/classification/${validatedLeaderClassificationId}`,
      {
        followerClassifications: {
          addOrUpdate: [validatedFollowerClassificationId],
        },
      },
      {
        headers: DamClassificationService.getJsonHeaders(),
      }
    ),
  {
    environment,
    leaderClassificationId: validatedLeaderClassificationId,
    followerClassificationId: validatedFollowerClassificationId,
  }
);

