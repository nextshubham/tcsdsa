private static getRequiredEnvironment(
  validatedPayload: CuNodeWebhookPayload
): string {
  const environment = validatedPayload.environment?.trim();

  if (!environment) {
    throw new Error('environment is required');
  }

  return environment;
}

private static async handleProcessingResult(
  validatedPayload: CuNodeWebhookPayload,
  response: Awaited<ReturnType<typeof PmClassificationWebhookService.process>>
): Promise<void> {
  const projectId =
    CuNodeWebhookController.getRequiredProjectId(validatedPayload);
  const environment =
    CuNodeWebhookController.getRequiredEnvironment(validatedPayload);

  if (response.status === 'SUCCESS') {
    await CuNodeWebhookController.handleSuccessfulProcessing(
      validatedPayload,
      projectId,
      environment
    );
    return;
  }

  await PmProjectStatusService.markFail(
    projectId,
    CuNodeWebhookController.getWarningMessage(response.warnings),
    environment
  );
}

private static async handleSuccessfulProcessing(
  validatedPayload: CuNodeWebhookPayload,
  projectId: string | number,
  environment: string
): Promise<void> {
  const body = CuNodeWebhookController.getRequiredBody(validatedPayload);

  await PmProjectStatusService.markPass(projectId, environment);

  if (!body.taskId) {
    return;
  }

  await CuNodeWebhookController.closeTaskSafely(body.taskId, environment);
}

private static logRequestReceived(
  payload: CuNodeWebhookPayload,
  validatedPayload: CuNodeWebhookPayload
): void {
  const body = CuNodeWebhookController.getRequiredBody(validatedPayload);
  const environment =
    CuNodeWebhookController.getRequiredEnvironment(validatedPayload);

  logger.info({
    msg: 'PM classification webhook request received',
    options: {
      environment,
      triggerType: validatedPayload.triggerType,
      projectId: body.projectId,
      taskId: body.taskId,
      inputParameterEaId: body.inputParameterEaId,
      sourcePayloadType: payload.Body ? 'PM_WEBHOOK' : 'LOCAL_TEST',
    },
  });
}

private static logRequestCompleted(
  validatedPayload: CuNodeWebhookPayload,
  response: Awaited<ReturnType<typeof PmClassificationWebhookService.process>>
): void {
  const body = CuNodeWebhookController.getRequiredBody(validatedPayload);
  const environment =
    CuNodeWebhookController.getRequiredEnvironment(validatedPayload);

  logger.info({
    msg: 'PM classification webhook request completed',
    options: {
      environment,
      triggerType: validatedPayload.triggerType,
      projectId: body.projectId,
      taskId: body.taskId,
      status: response.status,
    },
  });
}

