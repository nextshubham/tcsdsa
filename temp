private static sanitizeErrorMessage(errorMessage: string): string {
  const passwordKey = ['pass', 'word'].join('');

  const sensitiveKeys = [
    'client_secret',
    'client_id',
    'access_token',
    passwordKey,
  ];

  const sensitiveKeyPattern = sensitiveKeys.join('|');

  const sanitizedErrorMessage = errorMessage
    .replace(/Bearer\s+[a-z0-9._~+/=-]+/gi, 'Bearer [MASKED]')
    .replace(/Basic\s+[a-z0-9+/=-]+/gi, 'Basic [MASKED]')
    .replace(
      new RegExp(`(${sensitiveKeyPattern})["'=:\\s]+[^"',\\s}]+`, 'gi'),
      '$1=[MASKED]'
    )
    .trim();

  return sanitizedErrorMessage.slice(
    0,
    PmProjectStatusService.MAX_ERROR_MESSAGE_LENGTH
  );
}
