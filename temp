import config from '../config/env';
import httpClient from '../utils/httpClient';
import logger from '../utils/logger';

interface AppConfig {
  PM_BASE_URL?: string;
  BASE_URL?: string;
  APRIMO_BASE_URL?: string;
}

export interface PmActivityExtendedAttribute {
  eaId: string | number;
  eaValue?: string | number | boolean | null;
}

export interface PmActivityDetails {
  activityId: string | number;
  extendedAttributes?: PmActivityExtendedAttribute[];
}

export class PmActivityService {
  public static async getActivityDetails(
    activityId: string | number,
    environment: string
  ): Promise<PmActivityDetails> {
    const url = PmActivityService.buildActivityDetailsUrl(String(activityId));

    logger.info({
      msg: 'Fetching PM activity details',
      options: {
        activityId,
        environment,
      },
    });

    const response = await httpClient.get<PmActivityDetails>(url);

    return response.data;
  }

  private static buildActivityDetailsUrl(activityId: string): string {
    const pmBaseUrl = PmActivityService.getPmBaseUrl();

    return new URL(`/api/activities/${activityId}`, pmBaseUrl).toString();
  }

  private static getPmBaseUrl(): string {
    const appConfig = config as AppConfig;
    const pmBaseUrl =
      appConfig.PM_BASE_URL ?? appConfig.BASE_URL ?? appConfig.APRIMO_BASE_URL;

    if (!pmBaseUrl?.trim()) {
      throw new Error('PM_BASE_URL or BASE_URL is not configured');
    }

    return pmBaseUrl.trim();
  }
}

