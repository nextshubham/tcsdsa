private static normalizeObjectType(objectType?: string): PmObjectType {
  const normalizedObjectType = objectType?.trim();

  if (!normalizedObjectType) {
    return 'Project';
  }

  if (normalizedObjectType !== 'Project' && normalizedObjectType !== 'Activity') {
    throw new Error(`Unsupported ObjectType: ${normalizedObjectType}`);
  }

  return normalizedObjectType;
}

